+@click.command("config", short_help="Show the config for the app.")
+@with_appcontext
+def config_command() -> None:
+    """Show the config for the app. Masking the values of any key containing
+    SECRET, PASSWORD, TOKEN or KEY as "***".
+    """
+    import json
+
+    config = dict(current_app.config)
+    mask_keys = {"SECRET", "PASSWORD", "TOKEN", "KEY"}
+
+    for key in config:
+        if any(mask in key for mask in mask_keys):
+            config[key] = "***"
+
+    def _json_encoder(obj: t.Any) -> t.Any:
+        try:
+            return str(obj)
+        except Exception:
+            return repr(obj)
+
+    click.echo(json.dumps(config, indent=4, sort_keys=True, default=_json_encoder))
+
+
